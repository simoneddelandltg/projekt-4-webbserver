{% extends "base.html.twig" %}

{% block title %}Exempelsida med Twig{% endblock %}

{% block main %}
  <h1>Exempelsida med Twig</h1>
  <div>
    Här visas värdet av variabeln namn: {{ namn }}
  </div>
  
  <h2>Allt i en lista</h2>
  <ul>
  {% for item in users %}
    <li>{{ item.UserId }} {{ item.Username }}</li>
  {% endfor %}
  </ul>
{% endblock %}



